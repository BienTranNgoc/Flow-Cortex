# The backend's CORS check compares Origin with the scheme, host and port it is forwarded, so they
# must be the ones the browser used: the published port (not this container's 8080) and, behind
# Caddy, its https rather than this hop's http.
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}
map $http_host $forwarded_port {
    "~:(?<port>[0-9]+)$" $port;
    default              "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Every response, errors included. A location that declares its own add_header would drop
    # these, so none does.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    # The console PUTs uploads to the object store's public origin and shows files the API
    # redirects there; a browser applies the CSP again after that redirect. MEDIA_ORIGIN
    # (scheme://host[:port], the origin S3_PUBLIC_ENDPOINT is signed for) is the one origin
    # allowed beyond 'self'; empty leaves 'self' alone. The image start script fills it in.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' ${MEDIA_ORIGIN}; media-src 'self' ${MEDIA_ORIGIN}; connect-src 'self' ${MEDIA_ORIGIN}; frame-ancestors 'none'; object-src 'none'; base-uri 'none'" always;

    # SPA client-side routing: serve index.html for any unmatched path.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin API: forward /api/* to the backend service on the compose
    # network. proxy_pass without a trailing path preserves the full URI, so
    # /api/v1/health -> backend:8080/api/v1/health.
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Port $forwarded_port;
        # Above the backend's flowcortex.media.s3.copy-timeout (2m), which a run start can spend copying inputs.
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
    }
}
