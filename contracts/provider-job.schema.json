{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcortex.dev/contracts/provider-job.schema.json",
  "title": "ProviderJob",
  "description": "A typed provider job. Product content is carried only in params.payload and must not be logged.",
  "oneOf": [
    { "$ref": "#/$defs/generateScriptJob" },
    { "$ref": "#/$defs/generateStoryboardJob" },
    { "$ref": "#/$defs/generateSpeechJob" },
    { "$ref": "#/$defs/generateKeyframeJob" },
    { "$ref": "#/$defs/generateVideoJob" },
    { "$ref": "#/$defs/lipsyncVideoJob" }
  ],
  "$defs": {
    "productPayload": {
      "title": "ProductAdPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "description"],
      "properties": {
        "productName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "cta": { "type": "string", "minLength": 1, "maxLength": 500 },
        "price": { "type": "string", "minLength": 1, "maxLength": 200 },
        "promotion": { "type": "string", "minLength": 1, "maxLength": 500 },
        "templateId": { "enum": ["showroom-v1", "mc-v1"] },
        "scenePreset": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sceneNote": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "productAdParams": {
      "title": "ProductAdParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "product_ad_v1" },
        "payload": { "$ref": "#/$defs/productPayload" }
      }
    },
    "speechPayload": {
      "title": "SpeechPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "sourceRevisionId"],
      "properties": {
        "script": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "sourceRevisionId": { "type": "string", "format": "uuid" },
        "voiceGender": { "enum": ["male", "female"] },
        "voice": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mcHookScript": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "productCloseScript": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "storyboardPayload": {
      "title": "StoryboardPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "sourceRevisionId"],
      "properties": {
        "script": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "sourceRevisionId": { "type": "string", "format": "uuid" },
        "templateId": { "enum": ["showroom-v1", "mc-v1"] },
        "scenePreset": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sceneNote": { "type": "string", "minLength": 1, "maxLength": 500 },
        "mcHookScript": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "productCloseScript": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "storyboardParams": {
      "title": "StoryboardParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "product_ad_storyboard_v1" },
        "payload": { "$ref": "#/$defs/storyboardPayload" }
      }
    },
    "speechParams": {
      "title": "SpeechParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "vi_voice_v1" },
        "payload": { "$ref": "#/$defs/speechPayload" }
      }
    },
    "keyframePayload": {
      "title": "KeyframePayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "sourceRevisionId"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "sourceRevisionId": { "type": "string", "format": "uuid" },
        "scenePreset": { "type": "string", "minLength": 1, "maxLength": 64 },
        "sceneNote": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "keyframeParams": {
      "title": "KeyframeParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "vertical_ad_keyframe_v1" },
        "payload": { "$ref": "#/$defs/keyframePayload" }
      }
    },
    "videoPayload": {
      "title": "VideoPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "sourceRevisionId"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "sourceRevisionId": { "type": "string", "format": "uuid" },
        "durationSeconds": { "type": "integer", "minimum": 4, "maximum": 10 },
        "resolution": { "enum": ["480p", "720p", "768p"] },
        "firstFrameKey": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "lipsyncPayload": {
      "title": "LipsyncPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRevisionId"],
      "properties": {
        "sourceRevisionId": { "type": "string", "format": "uuid" },
        "durationSeconds": { "type": "integer", "minimum": 2, "maximum": 10 }
      }
    },
    "lipsyncParams": {
      "title": "LipsyncParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "vertical_ad_lipsync_v1" },
        "payload": { "$ref": "#/$defs/lipsyncPayload" }
      }
    },
    "videoInput": {
      "title": "VideoInput",
      "description": "A reference asset the worker fetches from the media store and forwards to the provider.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "bucket", "objectKey"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Logical name inside this job; e.g. 'product_1', 'mc', 'background', 'video', 'audio'."
        },
        "bucket": { "type": "string", "minLength": 1 },
        "objectKey": { "type": "string", "minLength": 1 }
      }
    },
    "videoParams": {
      "title": "VideoParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "enum": ["vertical_ad_clip_v1", "vertical_ad_clip_v2"] },
        "payload": { "$ref": "#/$defs/videoPayload" }
      }
    },
    "generateScriptJob": {
      "title": "GenerateScriptJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "runId",
        "correlationId",
        "stepOrder",
        "capability",
        "params",
        "outputPrefix",
        "attempt",
        "maxRuntimeSeconds",
        "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "jobId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "description": "Equal to runId (enforced by the producer); also sent as the AMQP correlation id."
        },
        "stepOrder": { "type": "integer", "minimum": 1 },
        "capability": { "const": "generate_script" },
        "params": { "$ref": "#/$defs/productAdParams" },
        "inputs": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/videoInput" },
          "description": "Optional product images (up to 3) the worker forwards to the multimodal script provider."
        },
        "outputPrefix": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$",
          "description": "The only object-key prefix under which this job may publish outputs."
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "generateSpeechJob": {
      "title": "GenerateSpeechJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "runId",
        "correlationId",
        "stepOrder",
        "capability",
        "params",
        "outputPrefix",
        "attempt",
        "maxRuntimeSeconds",
        "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "jobId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "description": "Equal to runId (enforced by the producer); also sent as the AMQP correlation id."
        },
        "stepOrder": { "type": "integer", "minimum": 1 },
        "capability": { "const": "generate_speech" },
        "params": { "$ref": "#/$defs/speechParams" },
        "outputPrefix": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$",
          "description": "The only object-key prefix under which this job may publish outputs."
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "generateStoryboardJob": {
      "title": "GenerateStoryboardJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "jobId", "runId", "correlationId", "stepOrder",
        "capability", "params", "outputPrefix", "attempt", "maxRuntimeSeconds", "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "jobId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "description": "Equal to runId (enforced by the producer); also sent as the AMQP correlation id."
        },
        "stepOrder": { "type": "integer", "minimum": 1 },
        "capability": { "const": "generate_storyboard" },
        "params": { "$ref": "#/$defs/storyboardParams" },
        "inputs": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/videoInput" },
          "description": "Optional product images (up to 3) the worker forwards to the multimodal storyboard provider."
        },
        "outputPrefix": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$",
          "description": "The only object-key prefix under which this job may publish outputs."
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "generateKeyframeJob": {
      "title": "GenerateKeyframeJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "jobId", "runId", "correlationId", "stepOrder",
        "capability", "params", "outputPrefix", "attempt", "maxRuntimeSeconds", "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "jobId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "correlationId": { "type": "string", "format": "uuid" },
        "stepOrder": { "type": "integer", "minimum": 1 },
        "capability": { "const": "generate_keyframe" },
        "params": { "$ref": "#/$defs/keyframeParams" },
        "inputs": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/videoInput" },
          "description": "Product images (1-3), optional MC portrait and optional background image."
        },
        "outputPrefix": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$"
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "vendorLedger": { "$ref": "#/$defs/vendorLedger" }
      }
    },
    "generateVideoJob": {
      "title": "GenerateVideoJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "runId",
        "correlationId",
        "stepOrder",
        "capability",
        "params",
        "outputPrefix",
        "attempt",
        "maxRuntimeSeconds",
        "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "jobId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "description": "Equal to runId (enforced by the producer); also sent as the AMQP correlation id."
        },
        "stepOrder": { "type": "integer", "minimum": 1 },
        "capability": { "const": "generate_video" },
        "params": { "$ref": "#/$defs/videoParams" },
        "inputs": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/videoInput" },
          "description": "Optional first-frame keyframe and up to 3 product reference images."
        },
        "outputPrefix": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$",
          "description": "The only object-key prefix under which this job may publish outputs."
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "vendorLedger": { "$ref": "#/$defs/vendorLedger" }
      }
    },
    "lipsyncVideoJob": {
      "title": "LipsyncVideoJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "jobId", "runId", "correlationId", "stepOrder",
        "capability", "params", "inputs", "outputPrefix", "attempt", "maxRuntimeSeconds", "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "jobId": { "type": "string", "format": "uuid" },
        "runId": { "type": "string", "format": "uuid" },
        "correlationId": { "type": "string", "format": "uuid" },
        "stepOrder": { "type": "integer", "minimum": 1 },
        "capability": { "const": "lipsync_video" },
        "params": { "$ref": "#/$defs/lipsyncParams" },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/videoInput" },
          "description": "Source video ('video') and speech WAV ('audio') for lip-sync."
        },
        "outputPrefix": {
          "type": "string",
          "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$"
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
        "issuedAt": { "type": "string", "format": "date-time" },
        "vendorLedger": { "$ref": "#/$defs/vendorLedger" }
      }
    },
    "vendorLedger": {
      "title": "VendorLedger",
      "description": "Vendor jobs the backend ledger holds for this ask. Optional: a worker given none submits a new vendor job.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestKey", "candidates"],
      "properties": {
        "requestKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "candidates": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/vendorCandidate" }
        }
      }
    },
    "vendorCandidate": {
      "title": "VendorCandidate",
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorTaskId", "vendor", "model", "fingerprint", "vendorJobId", "handle"],
      "properties": {
        "vendorTaskId": { "type": "string", "format": "uuid" },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 32 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "vendorJobId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "handle": {
          "type": "object",
          "maxProperties": 16,
          "description": "Vendor job identifiers only, at most 2048 bytes serialized; never a credential or signed URL."
        }
      }
    }
  }
}
