{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowcortex.dev/contracts/provider-job.schema.json",
  "title": "ProviderJob",
  "description": "A typed provider job. Product content is carried only in params.payload and must not be logged.",
  "oneOf": [
    { "$ref": "#/$defs/generateScriptJob" },
    { "$ref": "#/$defs/generateSpeechJob" }
  ],
  "$defs": {
    "commonProperties": {
      "schemaVersion": { "const": "1" },
      "jobId": { "type": "string", "format": "uuid" },
      "runId": { "type": "string", "format": "uuid" },
      "correlationId": {
        "type": "string",
        "format": "uuid",
        "description": "Equal to runId (enforced by the producer); also sent as the AMQP correlation id."
      },
      "stepOrder": { "type": "integer", "minimum": 1 },
      "outputPrefix": {
        "type": "string",
        "pattern": "^runs/[0-9a-f-]{36}/steps/[1-9][0-9]*/attempts/[1-9][0-9]*/$",
        "description": "The only object-key prefix under which this job may publish outputs."
      },
      "attempt": { "type": "integer", "minimum": 1 },
      "maxRuntimeSeconds": { "type": "integer", "minimum": 1 },
      "issuedAt": { "type": "string", "format": "date-time" }
    },
    "productPayload": {
      "title": "ProductAdPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "description", "cta"],
      "properties": {
        "productName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "cta": { "type": "string", "minLength": 1, "maxLength": 500 },
        "price": { "type": "string", "minLength": 1, "maxLength": 200 },
        "promotion": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "productAdParams": {
      "title": "ProductAdParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "product_ad_v1" },
        "payload": { "$ref": "#/$defs/productPayload" }
      }
    },
    "speechPayload": {
      "title": "SpeechPayload",
      "type": "object",
      "additionalProperties": false,
      "required": ["script"],
      "properties": {
        "script": { "type": "string", "minLength": 1, "maxLength": 8000 }
      }
    },
    "speechParams": {
      "title": "SpeechParams",
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "payload"],
      "properties": {
        "profile": { "const": "vi_voice_v1" },
        "payload": { "$ref": "#/$defs/speechPayload" }
      }
    },
    "generateScriptJob": {
      "title": "GenerateScriptJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "runId",
        "correlationId",
        "stepOrder",
        "capability",
        "params",
        "outputPrefix",
        "attempt",
        "maxRuntimeSeconds",
        "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/commonProperties/schemaVersion" },
        "jobId": { "$ref": "#/$defs/commonProperties/jobId" },
        "runId": { "$ref": "#/$defs/commonProperties/runId" },
        "correlationId": { "$ref": "#/$defs/commonProperties/correlationId" },
        "stepOrder": { "$ref": "#/$defs/commonProperties/stepOrder" },
        "capability": { "const": "generate_script" },
        "params": { "$ref": "#/$defs/productAdParams" },
        "outputPrefix": { "$ref": "#/$defs/commonProperties/outputPrefix" },
        "attempt": { "$ref": "#/$defs/commonProperties/attempt" },
        "maxRuntimeSeconds": { "$ref": "#/$defs/commonProperties/maxRuntimeSeconds" },
        "issuedAt": { "$ref": "#/$defs/commonProperties/issuedAt" }
      }
    },
    "generateSpeechJob": {
      "title": "GenerateSpeechJob",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "jobId",
        "runId",
        "correlationId",
        "stepOrder",
        "capability",
        "params",
        "outputPrefix",
        "attempt",
        "maxRuntimeSeconds",
        "issuedAt"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/commonProperties/schemaVersion" },
        "jobId": { "$ref": "#/$defs/commonProperties/jobId" },
        "runId": { "$ref": "#/$defs/commonProperties/runId" },
        "correlationId": { "$ref": "#/$defs/commonProperties/correlationId" },
        "stepOrder": { "$ref": "#/$defs/commonProperties/stepOrder" },
        "capability": { "const": "generate_speech" },
        "params": { "$ref": "#/$defs/speechParams" },
        "outputPrefix": { "$ref": "#/$defs/commonProperties/outputPrefix" },
        "attempt": { "$ref": "#/$defs/commonProperties/attempt" },
        "maxRuntimeSeconds": { "$ref": "#/$defs/commonProperties/maxRuntimeSeconds" },
        "issuedAt": { "$ref": "#/$defs/commonProperties/issuedAt" }
      }
    }
  }
}
