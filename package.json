{
  "name": "flow-cortex",
  "version": "0.1.0",
  "private": true,
  "description": "Flow-Cortex JavaScript workspaces: member SPA, admin SPA and shared packages.",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "frontend",
    "admin",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "gen:api": "npm run gen:api --workspaces --if-present"
  }
}
