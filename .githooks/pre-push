#!/usr/bin/env bash
#
# pre-push hook: block direct pushes to protected branches. `main` is production
# (it maps to Xood's `production`); work goes feature branch -> PR into
# `development`, and only `development` is merged into `main` on release.
# Server-side branch protection is the authoritative enforcement; this is fast
# local feedback.
# Enable with:  git config core.hooksPath .githooks   (or run scripts/setup-hooks.sh)

set -euo pipefail

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      branch="${remote_ref#refs/heads/}"
      echo "✗ Direct pushes to '$branch' are not allowed." >&2
      echo "" >&2
      echo "  Create a feature branch off 'development' and open a PR into 'development':" >&2
      echo "    git switch -c feat/your-change origin/development" >&2
      echo "    git push -u origin feat/your-change" >&2
      echo "    gh pr create --base development" >&2
      echo "" >&2
      echo "  '$branch' is production: it only accepts release PRs from 'development'." >&2
      exit 1
      ;;
  esac
done

exit 0
