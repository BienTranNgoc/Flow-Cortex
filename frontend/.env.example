# Flow-Cortex Frontend environment variables.
# Copy this file to `.env.local` and adjust values. `.env*` (except *.example)
# is git-ignored.

# The app calls the API at the relative path `/api/v1`: `npm run dev` proxies
# `/api` to http://localhost:8080 and the nginx image proxies it to the backend
# container.

# Build-time UI flags, all off unless set to `true`.
# "Continue with Google" button; needs the backend OAuth flow.
VITE_OAUTH_ENABLED=false
# Demo-only credits/XP/rank placeholders on the header and profile — never in production.
VITE_ACCOUNT_STATS_ENABLED=false
# "Forgot password?" link; needs a /forgot-password route and the backend reset endpoint.
VITE_PASSWORD_RESET_ENABLED=false
# Demo-only runs list and integrations pages with placeholder data — never in production.
VITE_DEMO_PAGES_ENABLED=false
