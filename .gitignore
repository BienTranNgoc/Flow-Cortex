# OS / editor
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
# Share these editor configs with the team; keep the rest of .vscode/ local.
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log

# --- Backend (Gradle) ---
backend/build/
backend/.gradle/
# The wrapper jar + scripts ARE committed on purpose (reproducible builds).

# --- Secrets / local env ---
# .env* files hold per-machine config; commit only the *.example templates.
**/.env
**/.env.*.local

# Frontend node_modules is covered by frontend/.gitignore, but guard here too.
**/node_modules/

# --- Local tooling / planning workspace (not product logic) ---
# Local assistant/session config.
.claude/
# Spec & planning workspace — kept local, not part of the shared source.
openspec/
docs/PLAN.md
docs/jira-backlog.csv
*-Plan.pdf

# Local docker compose override
docker-compose.override.yml
