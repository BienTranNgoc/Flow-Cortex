{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::flowcortex-media/runs/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::flowcortex-media/runs/*/steps/*/attempts/*/speech.wav",
        "arn:aws:s3:::flowcortex-media/runs/*/steps/*/attempts/*/manifest.json"
      ]
    }
  ]
}
