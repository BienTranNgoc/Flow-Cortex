# One certificate per site. reverse_proxy passes the Host header through
# unchanged, which the store relies on: presigned URLs are signed for
# media.{$DOMAIN} and fail verification under any other host.

app.{$DOMAIN} {
	# The event stream stays out of encode: its default matcher covers text/*, and a compressor
	# would hold heartbeats back.
	@realtime path /api/v1/realtime/*
	handle @realtime {
		reverse_proxy frontend:8080
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:8080
	}
}

admin.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:8080
}

media.{$DOMAIN} {
	reverse_proxy minio:9000
}
