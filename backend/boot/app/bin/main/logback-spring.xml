<?xml version="1.0" encoding="UTF-8"?>
<!--
  The console keeps Boot's default line. Each record also goes to the OpenTelemetry SDK with these
  MDC entries as attributes; it is exported only when OTEL_LOGS_EXPORTER is otlp.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureMdcAttributes>traceId,spanId,runId,runStepId,jobId,attempt,deliveryCount</captureMdcAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
