# Copy to .env (gitignored) — docker compose loads it automatically.
# Never commit real values. Every `change-me` value must be replaced; the rest
# are defaults you may keep. This is the full list of what compose reads.

# JWT signing key: at least 32 characters (HS256).
JWT_SECRET=change-me-to-at-least-32-random-characters

# Local Postgres password (compose sets the same value for the API).
POSTGRES_PASSWORD=change-me

# Demo profile: seeds the demo accounts and workflows (DevDataSeeder).
# Dev-only credentials — remove this line for any shared or deployed stack.
SPRING_PROFILES_ACTIVE=dev

# Self-registration — the ADMIN who owns (lists, suspends) self-registered accounts.
# Empty, unknown, not ADMIN or not ACTIVE closes registration (403). The demo admin is shown.
FLOWCORTEX_REGISTRATION_OWNER_EMAIL=admin1@flowcortex.dev
# Attempts allowed per client IP per period (over it answers 429 with Retry-After).
FLOWCORTEX_REGISTRATION_PER_IP_CAPACITY=5
FLOWCORTEX_REGISTRATION_PER_IP_PERIOD=1h
# Attempts allowed per email (trimmed, lower-cased) per period, from any IP.
FLOWCORTEX_REGISTRATION_PER_EMAIL_CAPACITY=3
FLOWCORTEX_REGISTRATION_PER_EMAIL_PERIOD=1h

# Password login — failed attempts allowed per client IP per period (over it answers 429
# with Retry-After, before the password is checked). A single account also locks for 15 minutes
# after 5 wrong passwords.
FLOWCORTEX_LOGIN_FAILURES_PER_IP_CAPACITY=20
FLOWCORTEX_LOGIN_FAILURES_PER_IP_PERIOD=15m
# How long auth audit rows (IPs, user agents) are kept before a scheduled job deletes them.
FLOWCORTEX_AUTH_AUDIT_RETENTION=90d

# Sign in with Google — optional; an empty GOOGLE_CLIENT_ID switches it off (the authorize endpoint
# answers 503). Register GOOGLE_REDIRECT_URI as an authorized redirect URI at Google: the absolute
# backend callback URL, on the same origin as the app (the default matches the dev proxy).
# A Google account signs in by its Google id only; a new email is created through the same gate as
# self-registration (owner and limits above), and an email that already has an account is refused.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback

# RabbitMQ broker (compose passes the same values to the backend).
RABBITMQ_DEFAULT_USER=flowcortex
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
# The provider workers (provider-worker, provider-video-worker) have no broker
# administration/topology rights. They can only consume provider.jobs and
# provider.video.jobs and publish through the provider exchange. Both values go into an AMQP
# URL, so rabbitmq-init refuses any character outside A-Z a-z 0-9 . _ ~ -
PROVIDER_RABBITMQ_USER=flowcortex-provider
PROVIDER_RABBITMQ_PASS=change-me-provider-rabbitmq

# Object store root credentials: used only by the `minio` and `minio-init`
# services. The password needs at least 8 characters; use only letters, digits
# and . _ ~ - in both (minio-init embeds them in a URL).
MINIO_ROOT_USER=flowcortex-root
MINIO_ROOT_PASSWORD=change-me-minio-root

# One least-privilege store key per service, created by `minio-init`.
# Secret keys need at least 8 characters.
BACKEND_S3_ACCESS_KEY=flowcortex-backend
BACKEND_S3_SECRET_KEY=change-me-backend-secret
WORKER_S3_ACCESS_KEY=flowcortex-worker
WORKER_S3_SECRET_KEY=change-me-worker-secret
PROVIDER_S3_ACCESS_KEY=flowcortex-provider-worker
PROVIDER_S3_SECRET_KEY=change-me-provider-worker-secret
# Days a run's copied input images are kept in the media bucket before the store deletes
# them — optional, default 30. Keep it at least the longest a run may wait for review.
RUN_INPUT_RETENTION_DAYS=30

# Browser origins allowed to upload to the store (comma-separated, never `*`).
# They must match the member app's address: if you publish it on another port,
# list that origin here instead. Add the production origin when there is one.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Media engine — optional; the values shown are the defaults. The switch and
# the limits take effect on `docker compose up -d backend`.
# false refuses uploads and runs with a media step (503); text-only workflows still run.
FLOWCORTEX_MEDIA_ENABLED=true
# A job no worker picked up within this time fails with queue_timeout.
FLOWCORTEX_MEDIA_QUEUE_TIMEOUT=30m
# Longest a probe may run once picked up (run_timeout).
FLOWCORTEX_MEDIA_MAX_RUNTIME_PROBE=5m
FLOWCORTEX_MEDIA_MAX_RUNTIME_EXTRACT_AUDIO=10m
FLOWCORTEX_MEDIA_MAX_RUNTIME_ALIGN_AUDIO=10m
FLOWCORTEX_MEDIA_MAX_RUNTIME_RENDER_VIDEO=5m
# The broker's ack deadline per delivery; must exceed the longest run time + 2 min.
# It is a queue argument, fixed once the queue exists: changing it on an existing
# broker needs the queue deleted, or `docker compose down -v` (LOCAL_SETUP.md).
FLOWCORTEX_MEDIA_CONSUMER_TIMEOUT=20m
# The provider runtime shares that ack deadline, so its max runtimes are checked
# against consumer-timeout too. Script, storyboard and speech jobs (provider.jobs):
FLOWCORTEX_MEDIA_PROVIDER_MAX_RUNTIME=2m
# How long a dispatched provider job may wait for the provider worker.
FLOWCORTEX_MEDIA_PROVIDER_QUEUE_TIMEOUT=5m
# Video clips (provider.video.jobs) run on their own worker pool with their own
# limits: a clip polls its vendor for up to 8 minutes, and a clip that finds every
# video worker busy waits for one to finish.
FLOWCORTEX_MEDIA_PROVIDER_VIDEO_MAX_RUNTIME=10m
FLOWCORTEX_MEDIA_PROVIDER_VIDEO_QUEUE_TIMEOUT=15m
# Largest upload in bytes (500 MB), and the file types a member may upload.
# `extensions` is the audio/video allowlist (worker render); `product-image-extensions` is
# the product-video allowlist (the two are independent — flip the image list to gate that
# feature without changing the video allowlist).
FLOWCORTEX_MEDIA_UPLOAD_MAX_VIDEO_BYTES=524288000
FLOWCORTEX_MEDIA_UPLOAD_MAX_AUDIO_BYTES=104857600
FLOWCORTEX_MEDIA_UPLOAD_MAX_IMAGE_BYTES=10485760
FLOWCORTEX_MEDIA_UPLOAD_EXTENSIONS=mp4,mov,webm,mkv,m4a,mp3,wav
FLOWCORTEX_MEDIA_UPLOAD_PRODUCT_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Kill switches — optional; workflow defaults on, Product Video defaults off.
# false refuses new runs with 503.
FLOWCORTEX_WORKFLOW_ENABLED=true
FLOWCORTEX_PRODUCT_VIDEO_ENABLED=true
# false answers /api/v1/admin/** with 503 (the admin console shows it is off);
# the member app is unaffected.
FLOWCORTEX_ADMIN_ENABLED=true

# Provider workers — each capability is selected independently. Defaults remain deterministic and
# offline. For a real demo, set SCRIPT_PROVIDER=openai and SPEECH_PROVIDER=edge.
# provider-worker runs script, storyboard and speech; provider-video-worker runs the video clips
# (the VIDEO_*, SEEDANCE_*, VEO_* and WAN_* settings below), as PROVIDER_VIDEO_WORKERS replicas
# that each run one clip at a time.
# Edge TTS is demo-only: it calls Microsoft's undocumented Edge Read Aloud endpoint (no SLA, it
# has broken before) and sends the approved script to Microsoft. Production speech needs a
# contracted provider behind SPEECH_PROVIDER.
# Seedance, Veo and Wan are third-party services: the chosen vendor receives each storyboard
# scene prompt and, when the clip step sends one, the run's first product image. Check the
# vendor's data terms before pointing a real run at it.
# Secrets only ever live in this file / your shell env / secret manager, never in code,
# DB, broker message or frontend bundle.
#
# To use OpenAI copy with Edge Vietnamese speech:
#   SCRIPT_PROVIDER=openai
#   SPEECH_PROVIDER=edge
#   SCRIPT_PROVIDER_API_KEY=sk-...
#   SCRIPT_PROVIDER_BASE_URL=https://your-provider.example.com/v1
#   SCRIPT_PROVIDER_MODEL=your-model-name
#
# Seedance through BytePlus ModelArk (base URL ends in /api/v3; an Alibaba Cloud Model Studio
# base URL ending in /api/v1 also works):
#   VIDEO_PROVIDER=seedance
#   SEEDANCE_API_KEY=your-modelark-key
#   SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
#   SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
#   SEEDANCE_RESOLUTION=480p
#
# Veo through the Gemini API:
#   VIDEO_PROVIDER=veo
#   VEO_API_KEY=your-gemini-key
#   VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   VEO_MODEL=veo-3.1-fast-generate-preview
#
# Wan 2.2 5B Fast through Replicate:
#   VIDEO_PROVIDER=wan
#   WAN_API_KEY=your-replicate-token
#   WAN_BASE_URL=https://api.replicate.com/v1
#   WAN_MODEL=wan-video/wan-2.2-5b-fast
#   WAN_RESOLUTION=480p
PROVIDER_ADAPTER=fixture
SCRIPT_PROVIDER=fixture
SPEECH_PROVIDER=fixture
VIDEO_PROVIDER=fixture
# Capability-scoped credentials. Edge TTS does not require SPEECH_PROVIDER_API_KEY.
SCRIPT_PROVIDER_API_KEY=
SPEECH_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
SCRIPT_PROVIDER_BASE_URL=
SCRIPT_PROVIDER_MODEL=
SPEECH_PROVIDER_BASE_URL=
SPEECH_PROVIDER_MODEL=
VIDEO_PROVIDER_BASE_URL=
VIDEO_PROVIDER_MODEL=
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_RESOLUTION=480p
VEO_API_KEY=
VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VEO_MODEL=veo-3.1-fast-generate-preview
WAN_API_KEY=
WAN_BASE_URL=https://api.replicate.com/v1
WAN_MODEL=wan-video/wan-2.2-5b-fast
WAN_RESOLUTION=480p
WAN_FRAMES_PER_SECOND=24
WAN_NUM_FRAMES=121
VIDEO_PROVIDER_REQUEST_TIMEOUT_SECONDS=60
VIDEO_PROVIDER_POLL_INTERVAL_SECONDS=5
VIDEO_PROVIDER_POLL_TIMEOUT_SECONDS=480
# Seedance downloads the run's first product photo from a 10-minute presigned URL, so the
# object store must be reachable from the internet over HTTPS: set this to its public address
# (https://media.<domain>; compose.aws.yaml sets it from DOMAIN). The video worker refuses to
# start with Seedance while it is empty or not https://. Fixture, Veo and Wan ignore it.
S3_PUBLIC_ENDPOINT=
# How many clips run at once: one provider-video-worker container per clip.
PROVIDER_VIDEO_WORKERS=2
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+0%
FLOWCORTEX_PROVIDER_TIMEOUT_SECONDS=60

# Legacy fallback for existing deployments. Prefer the capability-scoped keys above.
# OPENAI_API_KEY=

# Name the worker reports in its logs and its result messages — optional.
WORKER_ID=flow-worker-1
PROVIDER_WORKER_ID=provider-worker-1

# Observability overlay (compose.observability.yaml) — required only with it.
# Grafana's `admin` password; there is no default, the overlay refuses to start without it.
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin
# Password of the read-only `flowcortex_monitor` role postgres-exporter signs in with
# (at least 8 characters).
POSTGRES_EXPORTER_PASSWORD=change-me-postgres-exporter

# Public deploy overlay (compose.aws.yaml) — required only with it. The apex
# domain: the overlay serves the app., admin. and media. subdomains of it and
# sets the store's public endpoint and allowed upload origin from it.
DOMAIN=example.com
