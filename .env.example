# Copy to .env (gitignored) — docker compose loads it automatically.
# Never commit real values. Every `change-me` value must be replaced; the rest
# are defaults you may keep. This is the full list of what compose reads.

# JWT signing key: at least 32 characters (HS256).
JWT_SECRET=change-me-to-at-least-32-random-characters

# Connector credential encryption: the id of the key that encrypts new tokens, and that key
# (32 random bytes, base64): openssl rand -base64 32. A bare bootRun under
# SPRING_PROFILES_ACTIVE=dev uses a dev keyring instead. Key ids are
# lower-case (KEYS_K1 is id k1; CURRENT must be k1, not K1). Rotating on compose takes two
# edits: add FLOWCORTEX_CONNECTORS_ENCRYPTION_KEYS_<ID> here AND a matching
# `FLOWCORTEX_CONNECTORS_ENCRYPTION_KEYS_<ID>: ${FLOWCORTEX_CONNECTORS_ENCRYPTION_KEYS_<ID>:?...}`
# line under backend.environment in docker-compose.yml, then switch CURRENT. Retiring a key
# means removing both lines. Losing a key makes the tokens stored under it unreadable.
FLOWCORTEX_CONNECTORS_ENCRYPTION_CURRENT=k1
FLOWCORTEX_CONNECTORS_ENCRYPTION_KEYS_K1=change-me-run-openssl-rand-base64-32

# Telegram connector switch. Stays off until the Telegram terms are settled; the host's
# egress ACL must also list api.telegram.org before it is turned on.
# FLOWCORTEX_CONNECTORS_TELEGRAM_ENABLED=false

# Local Postgres password (compose sets the same value for the API).
POSTGRES_PASSWORD=change-me

# Demo profile: seeds the demo accounts and workflows (DevDataSeeder).
# Dev-only credentials — remove this line for any shared or deployed stack.
SPRING_PROFILES_ACTIVE=dev

# Self-registration — the ADMIN who owns (lists, suspends) self-registered accounts.
# Empty, unknown, not ADMIN or not ACTIVE closes registration (403). The demo admin is shown.
FLOWCORTEX_REGISTRATION_OWNER_EMAIL=admin1@flowcortex.dev
# Attempts allowed per client IP per period (over it answers 429 with Retry-After).
FLOWCORTEX_REGISTRATION_PER_IP_CAPACITY=5
FLOWCORTEX_REGISTRATION_PER_IP_PERIOD=1h
# Attempts allowed per email (trimmed, lower-cased) per period, from any IP.
FLOWCORTEX_REGISTRATION_PER_EMAIL_CAPACITY=3
FLOWCORTEX_REGISTRATION_PER_EMAIL_PERIOD=1h

# Password login — failed attempts allowed per client IP per period (over it answers 429
# with Retry-After, before the password is checked). A single account also locks for 15 minutes
# after 5 wrong passwords.
FLOWCORTEX_LOGIN_FAILURES_PER_IP_CAPACITY=20
FLOWCORTEX_LOGIN_FAILURES_PER_IP_PERIOD=15m
# How long auth audit rows (IPs, user agents) are kept before a scheduled job deletes them.
FLOWCORTEX_AUTH_AUDIT_RETENTION=90d
# Admin audit rows are kept; their client address and user agent are cleared after this long,
# checked every interval. Zero or negative refuses startup.
FLOWCORTEX_ADMIN_AUDIT_ORIGIN_RETENTION=365d
FLOWCORTEX_ADMIN_AUDIT_RETENTION_INTERVAL=1h
# Deleted trend templates are purged after the grace period, at most batch-size per pass, every
# interval. Keep grace above the longest media URL lifetime plus the longest run that reads template
# media. Zero or negative refuses startup.
FLOWCORTEX_TREND_PURGE_INTERVAL=15m
FLOWCORTEX_TREND_PURGE_GRACE=8d
FLOWCORTEX_TREND_PURGE_BATCH_SIZE=20

# Browser error intake (POST /api/v1/client-errors): off answers 204 to everything without
# reading, limiting, logging or counting. Reports allowed per client IP per period (over it
# answers 429 with Retry-After).
FLOWCORTEX_CLIENT_ERRORS_ENABLED=true
FLOWCORTEX_CLIENT_ERRORS_PER_IP_CAPACITY=10
FLOWCORTEX_CLIENT_ERRORS_PER_IP_PERIOD=1m

# Rate-limit budgets are stored in the database and shared by every backend instance. The store has
# its own small connection pool; a stalled store admits the request after the connection or lock
# timeout. Full buckets are swept every interval (ISO-8601 duration).
FLOWCORTEX_RATE_LIMIT_SWEEP_INTERVAL=PT10M
FLOWCORTEX_RATE_LIMIT_STORE_MAX_POOL_SIZE=8
FLOWCORTEX_RATE_LIMIT_STORE_CONNECTION_TIMEOUT=250ms
FLOWCORTEX_RATE_LIMIT_STORE_LOCK_TIMEOUT=200ms
FLOWCORTEX_RATE_LIMIT_STORE_STATEMENT_TIMEOUT=500ms

# Forgot password — off answers 503 on both reset endpoints. On needs SPRING_MAIL_HOST and
# FLOWCORTEX_APP_PUBLIC_URL below, or the backend refuses to start. A reset link works once, for
# the validity. Requests allowed per client IP and per email (trimmed, lower-cased) per period
# (over it answers 429 with Retry-After), and new-password submissions allowed per client IP per
# period (same 429).
FLOWCORTEX_AUTH_PASSWORD_RESET_ENABLED=true
FLOWCORTEX_AUTH_PASSWORD_RESET_VALIDITY=1h
FLOWCORTEX_AUTH_PASSWORD_RESET_PER_IP_CAPACITY=5
FLOWCORTEX_AUTH_PASSWORD_RESET_PER_IP_PERIOD=1h
FLOWCORTEX_AUTH_PASSWORD_RESET_PER_EMAIL_CAPACITY=3
FLOWCORTEX_AUTH_PASSWORD_RESET_PER_EMAIL_PERIOD=1h
FLOWCORTEX_AUTH_PASSWORD_RESET_SUBMIT_PER_IP_CAPACITY=10
FLOWCORTEX_AUTH_PASSWORD_RESET_SUBMIT_PER_IP_PERIOD=1h

# Step-up password check (POST /api/v1/me/step-up): password attempts allowed per signed-in user per
# period, every attempt counted; over it answers 429 with Retry-After before the password is
# compared. It also refuses, rather than admits, while the rate-limit store is unavailable.
FLOWCORTEX_AUTH_STEP_UP_PER_USER_CAPACITY=5
FLOWCORTEX_AUTH_STEP_UP_PER_USER_PERIOD=1m

# Personal access tokens (fc_pat_...) for scripted API calls by admin accounts — off answers 503 on
# the /api/v1/me/api-tokens routes and 401 to any fc_pat_ bearer. A user holds at most MAX_LIVE_PER_USER
# live tokens; DEFAULT_LIFETIME applies when a create request names none. Each token value gets
# PER_MINUTE and PER_DAY requests (over either answers 429 with Retry-After).
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_ENABLED=false
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_MAX_LIVE_PER_USER=10
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_DEFAULT_LIFETIME=90d
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_PER_MINUTE_CAPACITY=60
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_PER_MINUTE_PERIOD=1m
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_PER_DAY_CAPACITY=1000
FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_PER_DAY_PERIOD=1d

# MCP authorization server — off answers 503 on every /api/v1/oauth route and on
# /.well-known/oauth-authorization-server. On needs FLOWCORTEX_AUTH_PERSONAL_ACCESS_TOKENS_ENABLED
# above and FLOWCORTEX_APP_PUBLIC_URL below, or the backend refuses to start. Registrations allowed per
# client IP per period and token/revoke requests per client IP per period (over it answers 429 with
# Retry-After).
FLOWCORTEX_AUTH_MCP_OAUTH_ENABLED=false
FLOWCORTEX_AUTH_MCP_OAUTH_REGISTER_PER_IP_CAPACITY=10
FLOWCORTEX_AUTH_MCP_OAUTH_REGISTER_PER_IP_PERIOD=1h
FLOWCORTEX_AUTH_MCP_OAUTH_TOKEN_PER_IP_CAPACITY=30
FLOWCORTEX_AUTH_MCP_OAUTH_TOKEN_PER_IP_PERIOD=1m

# Writes made with a personal access token: every one is recorded (route and outcome, no body). The two
# limits cap an owner's token writes, and their workflow creations, per UTC day; 0 is off, negative
# stops startup (over the cap answers 429 with Retry-After until 00:00 UTC).
FLOWCORTEX_AUTH_API_TOKEN_CALLS_DAILY_WRITE_LIMIT=0
FLOWCORTEX_AUTH_API_TOKEN_CALLS_DAILY_WORKFLOW_CREATE_LIMIT=0

# Sign in with Google — optional; an empty GOOGLE_CLIENT_ID switches it off (the authorize endpoint
# answers 503). Register GOOGLE_REDIRECT_URI as an authorized redirect URI at Google: the absolute
# backend callback URL, on the same origin as the app (the default matches the dev proxy).
# A Google account signs in by its Google id only; a new email is created through the same gate as
# self-registration (owner and limits above), and an email that already has an account is refused.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback

# Gemini API key (Google AI Studio) for the Help Center assistant and Vietnamese dubbing —
# optional; set it before turning either on. Sent only in the x-goog-api-key header and never
# logged. Empty leaves the backend booting, but every assistant answer and dub step fails.
GEMINI_API_KEY=
# One Gemini client serves the assistant and dubbing, so GEMINI_BASE_URL (default: Google's public
# endpoint) reaches both. Longest an assistant answer may take, in total (default 20s).
# GEMINI_READ_TIMEOUT (default 20s) is per request and does not bound the whole answer; the dub
# steps' models, retries and per-call timeouts are set in flowcortex.llm.gemini.slots.
# GEMINI_ANSWER_TIMEOUT=20s
# Content-safety threshold sent with every Gemini JSON call (default BLOCK_MEDIUM_AND_ABOVE); one of
# BLOCK_LOW_AND_ABOVE, BLOCK_MEDIUM_AND_ABOVE, BLOCK_ONLY_HIGH, BLOCK_NONE, OFF. Any other value stops
# startup. The dub translate slot sets its own (OFF) in flowcortex.llm.gemini.slots.
# GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE

# Help Center — optional; the values shown are the defaults. Off hides the help button and answers
# the member and guest support routes with 503 (the admin console keeps working). The assistant
# needs its own switch on too, and can also be paused from the admin console. Restart to apply.
# Before switching it on in a shared stack: three published "Bắt đầu" articles and a contact address.
FLOWCORTEX_SUPPORT_ENABLED=false
FLOWCORTEX_SUPPORT_ASSISTANT_ENABLED=false
# Address guests and suspended members are shown; empty shows no contact line.
FLOWCORTEX_SUPPORT_CONTACT_EMAIL=
# Assistant models, a comma list: the first leads, the next answers when it fails or is switched off in
# the admin AI registry. Each gets one 9s attempt; startup fails when the list outlasts GEMINI_ANSWER_TIMEOUT.
FLOWCORTEX_SUPPORT_ASSISTANT_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# HMAC key for guest session ids and network addresses; at least 32 characters, required while the
# assistant is on. Changing it orphans guest conversations and restarts guest quotas. Empty here: the
# local compose stack then uses its own dev-only key; anywhere else, set a random one.
FLOWCORTEX_SUPPORT_HASH_SECRET=
# HMAC key for the anonymous reader key in a shared workflow's access log; at least 32 characters,
# always required (sharing has no off switch). Left unset here: the local compose stack and a bare
# bootRun on the dev profile then use their own dev-only key; anywhere else, set a random one. Keep it
# unset rather than empty: a variable exported as an empty string is not replaced by that default.
# FLOWCORTEX_WORKFLOW_SHARE_HASH_SECRET=
# Anonymous reads of a share link (GET /api/v1/workflows/by-key/{key} without a token) allowed per
# client address per period (over it answers 429 with Retry-After); a signed-in reader is not counted.
FLOWCORTEX_WORKFLOW_SHARE_RATE_LIMIT_CAPACITY=30
FLOWCORTEX_WORKFLOW_SHARE_RATE_LIMIT_PERIOD=1m
# Assistant questions per day: over everyone (reaching it pauses the assistant until 00:00
# Asia/Ho_Chi_Minh), per member, per guest session, per guest network.
FLOWCORTEX_SUPPORT_ASSISTANT_DAILY_CEILING=2000
FLOWCORTEX_SUPPORT_MEMBER_DAILY_QUOTA=50
FLOWCORTEX_SUPPORT_GUEST_DAILY_QUOTA=10
FLOWCORTEX_SUPPORT_GUEST_NETWORK_DAILY_QUOTA=100
# Request lifecycle — optional; the values shown are the defaults. The three switches and three
# numbers are changed at runtime in the console Settings page; a switch set to false here stays off
# whatever is stored there. Auto-close: days after the member first opens a resolution (1-90).
# Reply mail: minutes replies to one request are gathered into one mail (0-1440; 0 mails on the
# next sweep). Retention: months a closed request is kept after its last activity (6-120).
# FLOWCORTEX_SUPPORT_AUTO_CLOSE_ENABLED=true
# FLOWCORTEX_SUPPORT_AUTO_CLOSE_RESOLVED_DAYS=7
# FLOWCORTEX_SUPPORT_REPLY_MAIL_ENABLED=true
# FLOWCORTEX_SUPPORT_REPLY_MAIL_WINDOW_MINUTES=0
# FLOWCORTEX_SUPPORT_RETENTION_ENABLED=true
# FLOWCORTEX_SUPPORT_RETENTION_CLOSED_REQUEST_MONTHS=24
# Support response deadline — optional; the values shown are the defaults. The switch and the four
# numbers are changed at runtime in the console Settings page; alerts set to false here stay off
# whatever is stored there. A new request is due soon after NEW_WARN_HOURS and overdue after NEW_HOURS
# (1-720 each); an in-progress request after IN_PROGRESS_WARN_DAYS and IN_PROGRESS_DAYS (1-90 each).
# Each warning must be below its limit or the backend does not start.
# FLOWCORTEX_SUPPORT_SLA_ALERTS_ENABLED=true
# FLOWCORTEX_SUPPORT_SLA_NEW_HOURS=24
# FLOWCORTEX_SUPPORT_SLA_NEW_WARN_HOURS=20
# FLOWCORTEX_SUPPORT_SLA_IN_PROGRESS_DAYS=3
# FLOWCORTEX_SUPPORT_SLA_IN_PROGRESS_WARN_DAYS=2

# Main chat — optional; the values shown are the defaults. Off hides the page (the features flag); the
# admin console's chat switch can also stop new sends. Restart to apply.
FLOWCORTEX_CHAT_ENABLED=false
FLOWCORTEX_CHAT_MODEL=gemini-3.5-flash
# Messages per day: per member and over everyone; messages per minute per member.
FLOWCORTEX_CHAT_MEMBER_DAILY_QUOTA=100
FLOWCORTEX_CHAT_GLOBAL_DAILY_QUOTA=5000
FLOWCORTEX_CHAT_PER_MINUTE=10
# Longest one answer may run, and the extra wait before the sweeper fails a stuck one.
FLOWCORTEX_CHAT_TURN_TIMEOUT=90s
FLOWCORTEX_CHAT_SWEEP_GRACE=30s
# Tool calls one answer may chain, and the worker threads and queue that run answers.
FLOWCORTEX_CHAT_MAX_TOOL_ROUNDS=4
FLOWCORTEX_CHAT_TURN_THREADS=8
FLOWCORTEX_CHAT_TURN_QUEUE=32
# Token cap of one answer, and the share of it the model may spend thinking (the cap counts both; the
# budget must stay below it). An answer that still hits the cap is kept, not failed.
FLOWCORTEX_CHAT_MAX_OUTPUT_TOKENS=8192
FLOWCORTEX_CHAT_THINKING_BUDGET=1024
# Most folders one member may keep for organizing conversations (at least 1).
FLOWCORTEX_CHAT_MAX_FOLDERS=100

# RabbitMQ broker (compose passes the same values to the backend).
RABBITMQ_DEFAULT_USER=flowcortex
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
# The provider workers (provider-worker, provider-video-worker) have no broker
# administration/topology rights. They can only consume provider.jobs and
# provider.video.jobs, configure/consume per-worker control reply queues under
# provider.control.reply.*, and publish through the provider exchange. Both values go into an AMQP
# URL, so rabbitmq-init refuses any character outside A-Z a-z 0-9 . _ ~ -
PROVIDER_RABBITMQ_USER=flowcortex-provider
PROVIDER_RABBITMQ_PASS=change-me-provider-rabbitmq
# The fetch worker parses content from the internet, so it gets a broker login of its own:
# it can only consume media.fetch.jobs and publish through the media exchange, and must
# differ from the two logins above (the egress isolation check refuses an equal one).
# Same character rule as above.
FETCH_RABBITMQ_USER=flowcortex-fetch-worker
FETCH_RABBITMQ_PASS=change-me-fetch-worker-rabbitmq

# Object store root credentials: used only by the `minio` and `minio-init`
# services. The password needs at least 8 characters; use only letters, digits
# and . _ ~ - in both (minio-init embeds them in a URL).
MINIO_ROOT_USER=flowcortex-root
MINIO_ROOT_PASSWORD=change-me-minio-root

# One least-privilege store key per service, created by `minio-init`.
# Secret keys need at least 8 characters.
BACKEND_S3_ACCESS_KEY=flowcortex-backend
BACKEND_S3_SECRET_KEY=change-me-backend-secret
WORKER_S3_ACCESS_KEY=flowcortex-worker
WORKER_S3_SECRET_KEY=change-me-worker-secret
PROVIDER_S3_ACCESS_KEY=flowcortex-provider-worker
PROVIDER_S3_SECRET_KEY=change-me-provider-worker-secret
# The fetch worker (the one service on the open `fetch` network) may only write under
# flowcortex-media/runs/: it can read no upload and no run object. Never reuse the
# worker's key for it; the egress isolation check refuses an equal key.
FETCH_S3_ACCESS_KEY=flowcortex-fetch-worker
FETCH_S3_SECRET_KEY=change-me-fetch-worker-secret
# Days a run's copied input images are kept in the media bucket before the store deletes
# them — optional, default 30. Keep it at least the longest a run may wait for review.
RUN_INPUT_RETENTION_DAYS=30

# Browser origins allowed to upload to the store (comma-separated, never `*`).
# They must match the member app's (5173) and the admin console's (5174) addresses: if you
# publish either on another port, list that origin here instead. Add the production origins
# when there are any.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Media engine — optional; the values shown are the defaults. The switch and
# the limits take effect on `docker compose up -d backend`.
# false refuses uploads and runs with a media step (503); text-only workflows still run.
FLOWCORTEX_MEDIA_ENABLED=true
# A job no worker picked up within this time fails with queue_timeout.
FLOWCORTEX_MEDIA_QUEUE_TIMEOUT=30m
# Longest a probe may run once picked up (run_timeout).
FLOWCORTEX_MEDIA_MAX_RUNTIME_PROBE=5m
FLOWCORTEX_MEDIA_MAX_RUNTIME_EXTRACT_AUDIO=10m
FLOWCORTEX_MEDIA_MAX_RUNTIME_ALIGN_AUDIO=10m
FLOWCORTEX_MEDIA_MAX_RUNTIME_RENDER_VIDEO=5m
FLOWCORTEX_MEDIA_MAX_RUNTIME_SEPARATE_AUDIO=15m
# A link download (fetch_video) on the fetch worker.
FLOWCORTEX_MEDIA_MAX_RUNTIME_FETCH_VIDEO=10m
# The broker's ack deadline per delivery; must exceed the longest run time + 2 min.
# It is a queue argument, fixed once the queue exists: changing it on an existing
# broker needs the queue deleted, or `docker compose down -v` (LOCAL_SETUP.md).
FLOWCORTEX_MEDIA_CONSUMER_TIMEOUT=20m
# The provider runtime shares that ack deadline, so its max runtimes are checked
# against consumer-timeout too. Script, storyboard and speech jobs (provider.jobs):
FLOWCORTEX_MEDIA_PROVIDER_MAX_RUNTIME=2m
# How long a dispatched provider job may wait for the provider worker.
FLOWCORTEX_MEDIA_PROVIDER_QUEUE_TIMEOUT=5m
# Video clips (provider.video.jobs) run on their own worker pool with their own
# limits: a clip polls its vendor for up to 8 minutes, and a clip that finds every
# video worker busy waits for one to finish.
FLOWCORTEX_MEDIA_PROVIDER_VIDEO_MAX_RUNTIME=10m
FLOWCORTEX_MEDIA_PROVIDER_VIDEO_QUEUE_TIMEOUT=15m
# Largest upload in bytes per kind (video 500 MB, audio 100 MB, image 10 MB), and the file
# types a member may upload. The video cap was FLOWCORTEX_MEDIA_UPLOAD_MAX_BYTES; that old name
# is still read when FLOWCORTEX_MEDIA_UPLOAD_MAX_VIDEO_BYTES is unset.
# `extensions` is the audio/video allowlist (worker render); `product-image-extensions` is
# the product-video allowlist (the two are independent — flip the image list to gate that
# feature without changing the video allowlist).
FLOWCORTEX_MEDIA_UPLOAD_MAX_VIDEO_BYTES=524288000
FLOWCORTEX_MEDIA_UPLOAD_MAX_AUDIO_BYTES=104857600
FLOWCORTEX_MEDIA_UPLOAD_MAX_IMAGE_BYTES=10485760
FLOWCORTEX_MEDIA_UPLOAD_EXTENSIONS=mp4,mov,webm,mkv,m4a,mp3,wav
FLOWCORTEX_MEDIA_UPLOAD_PRODUCT_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Kill switches — optional; workflow defaults on, Product Video defaults off.
# false refuses new runs with 503.
FLOWCORTEX_WORKFLOW_ENABLED=true
FLOWCORTEX_PRODUCT_VIDEO_ENABLED=true
# Concurrent Product Video clips (steps 5-6): off by default. Turn on only with wan/fixture and >=2 healthy video workers.
PRODUCT_VIDEO_PARALLEL_CLIPS_ENABLED=false
# false answers /api/v1/admin/** with 503 (the admin console shows it is off);
# the member app is unaffected.
FLOWCORTEX_ADMIN_ENABLED=true
# false forces role and permission edits off (503); unset lets the super admin decide on the Roles page.
# FLOWCORTEX_AUTHZ_RBAC_MUTATIONS_ENABLED=

# Demo switches — optional; compose turns all five on, application.yml keeps the first four off.
# Read at startup: change one, then `docker compose up -d backend`. GET /api/v1/features shows them.
# A new registration must open the emailed confirmation link before it can sign in, then sets
# its password. Needs SPRING_MAIL_HOST and FLOWCORTEX_APP_PUBLIC_URL below, or the backend
# refuses to start. Accounts left unconfirmed this long (with no live link) are deleted.
FLOWCORTEX_AUTH_EMAIL_CONFIRMATION_ENABLED=true
FLOWCORTEX_AUTH_UNCONFIRMED_ACCOUNT_RETENTION=72h
# The profile offers phone verification by SMS code; needs FLOWCORTEX_SMS_SENDER below.
FLOWCORTEX_PHONE_VERIFICATION_ENABLED=true
# On: a signed-in member without a verified phone number is refused (403) everywhere except the
# phone, sign-in, help and error-report routes, and the app shows a verify-phone page. Staff and super
# admins are exempt. Needs FLOWCORTEX_PHONE_VERIFICATION_ENABLED=true, or the backend refuses to
# start; the `outbox` sender delivers nothing, so only a real sender makes the wall passable.
FLOWCORTEX_PHONE_GATE_ENABLED=false
# An upload whose first bytes do not match its declared type is refused.
FLOWCORTEX_MEDIA_UPLOAD_CONTENT_CHECK_ENABLED=true
# A member can stop a running run.
FLOWCORTEX_WORKFLOW_CANCEL_ENABLED=true
# Runs are charged per step from a signup credit grant and refunded on system failures.
FLOWCORTEX_CREDITS_ENABLED=true
# Payments region gate: off places nobody, shadow (default) only counts callers outside Vietnam,
# enforce refuses them on payment-opening requests. Read at startup. The registry download runs
# every refresh interval, first after the initial delay (ISO-8601 durations).
FLOWCORTEX_BILLING_REGION_GATE_MODE=shadow
FLOWCORTEX_BILLING_REGION_GATE_REFRESH_INTERVAL=PT24H
FLOWCORTEX_BILLING_REGION_GATE_REFRESH_INITIAL_DELAY=PT10M
# MoMo payments stay off until the merchant contract is signed. With ENABLED=true the backend refuses to
# start unless every credential, both URLs and the callback source allowlist are set. IPN_URL must end in
# /api/v1/billing/webhooks/momo; the allowlist is comma-separated addresses or CIDR blocks from the contract.
FLOWCORTEX_BILLING_MOMO_ENABLED=false
FLOWCORTEX_BILLING_MOMO_BASE_URL=https://test-payment.momo.vn
FLOWCORTEX_BILLING_MOMO_PARTNER_CODE=
FLOWCORTEX_BILLING_MOMO_ACCESS_KEY=
FLOWCORTEX_BILLING_MOMO_SECRET_KEY=
FLOWCORTEX_BILLING_MOMO_REDIRECT_URL=
FLOWCORTEX_BILLING_MOMO_IPN_URL=
FLOWCORTEX_BILLING_MOMO_OFFERED_INSTRUMENTS=wallet
FLOWCORTEX_BILLING_MOMO_CALLBACK_SOURCE_ALLOWLIST=
FLOWCORTEX_BILLING_MOMO_CIRCUIT_ENABLED=true
FLOWCORTEX_BILLING_MOMO_CIRCUIT_FAILURE_THRESHOLD=5
FLOWCORTEX_BILLING_MOMO_CIRCUIT_OPEN_DURATION=PT30S
# The ledger applies accepted provider callbacks to payments every INTERVAL, at most BATCH_SIZE (1-1000) a pass;
# ENABLED=false leaves accepted callbacks waiting unapplied.
FLOWCORTEX_BILLING_LEDGER_APPLY_ENABLED=true
FLOWCORTEX_BILLING_LEDGER_APPLY_INTERVAL=PT5S
FLOWCORTEX_BILLING_LEDGER_APPLY_BATCH_SIZE=100
# Personal spaces: off makes the session space answer 503; spaces are still provisioned at activation.
FLOWCORTEX_SPACES_ENABLED=true
# Member Trash: off (the default) makes its routes answer 503 and the sweep and reminder jobs do nothing;
# recording still works. With it on, startup also needs FLOWCORTEX_APP_PUBLIC_URL (the reminder mail links to it).
# FLOWCORTEX_TRASH_ENABLED=false
# Member onboarding journey (welcome, tour, quiz): off hides it and makes progress writes answer 409.
FLOWCORTEX_ONBOARDING_ENABLED=true

# Where SMS go. `outbox` keeps every message in the sms_outbox table, read in the admin console:
# development stacks only, nothing reaches a phone. Empty sends nothing, and the backend then
# refuses to start while phone verification is on.
FLOWCORTEX_SMS_SENDER=outbox
# VietGuys SMS Brandname, used only with FLOWCORTEX_SMS_SENDER=vietguys (the backend then refuses to
# start unless every value below except the two URLs is set; its error names the setting, never the
# value). The three templates must match the texts registered for the brandname, use only the GSM-7
# basic character set (no diacritics), and fit 160 characters; the code template holds {CODE} once, the
# notices must not. The refresh token is the seed of the token chain: it is stored once and a renewed
# chain is never overwritten by the same value, so set a new one only after the carrier revoked the old.
# Each credential key is `openssl rand -base64 32`. To rotate: add FLOWCORTEX_SMS_CREDENTIAL_KEYS_K2,
# set FLOWCORTEX_SMS_CREDENTIAL_CURRENT_KEY_ID=k2, keep K1 until the next token renewal has re-sealed
# both stored tokens under k2, then drop K1. The VietGuys hosts must be on the egress proxy allowlist.
# FLOWCORTEX_VIETGUYS_SMS_URL=https://cloudsms4.vietguys.biz:4438/api/index.php
# FLOWCORTEX_VIETGUYS_TOKEN_URL=https://api-v2.vietguys.biz:4438/token/v1/refresh
# FLOWCORTEX_VIETGUYS_SMS_USERNAME=
# FLOWCORTEX_VIETGUYS_SMS_BRANDNAME=
# FLOWCORTEX_VIETGUYS_SMS_REFRESH_TOKEN=
# FLOWCORTEX_SMS_CREDENTIAL_KEYS_K1=
# FLOWCORTEX_SMS_CREDENTIAL_KEYS_K2=
# FLOWCORTEX_SMS_CREDENTIAL_CURRENT_KEY_ID=k1
# FLOWCORTEX_VIETGUYS_TEMPLATE_OTP=
# FLOWCORTEX_VIETGUYS_TEMPLATE_PHONE_CHANGED=
# FLOWCORTEX_VIETGUYS_TEMPLATE_PHONE_CHANGE_REVERTED=
# HMAC key for the phone numbers kept in send-attempt rows; at least 32 characters, required while
# phone verification is on. Changing it restarts every member's phone quotas. Empty here: the local
# compose stack then uses its own dev-only key; anywhere else, set a random one.
FLOWCORTEX_PHONE_HASH_SECRET=
# Phone code quotas over the last 24 h (the IP one per period); over one answers 429 with
# Retry-After. A member's sends and numbers also count "already verified elsewhere" answers.
FLOWCORTEX_PHONE_ALLOWED_COUNTRY_CODES=84
FLOWCORTEX_PHONE_USER_SENDS_PER_DAY=10
FLOWCORTEX_PHONE_USER_NUMBERS_PER_DAY=3
FLOWCORTEX_PHONE_PER_IP_CAPACITY=30
FLOWCORTEX_PHONE_PER_IP_PERIOD=1h
# Codes to one number from all members together, and to every number together.
FLOWCORTEX_PHONE_NUMBER_SENDS_PER_DAY=20
FLOWCORTEX_PHONE_GLOBAL_SENDS_PER_DAY=2000
# How long send attempts (they hold IPs) and outbox messages are kept.
FLOWCORTEX_PHONE_SEND_ATTEMPT_RETENTION=30d
FLOWCORTEX_SMS_OUTBOX_RETENTION=7d

# Outgoing mail (confirmation and set-password links, password notices). Empty here means
# the local compose stack's Mailpit sink (port 1025, no login). The public overlay
# (compose.aws.yaml) refuses to start until host, port, username and password name a real SMTP
# relay, and it turns on SMTP login and STARTTLS (SPRING_MAIL_SMTP_AUTH / SPRING_MAIL_SMTP_STARTTLS)
# itself; set those two to true here only to try a real relay from the local stack. Links in mail
# open the member app at FLOWCORTEX_APP_PUBLIC_URL (compose.aws.yaml sets it to https://app.<DOMAIN>).
# Host and public URL are required while email confirmation is on.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS=false
FLOWCORTEX_APP_PUBLIC_URL=http://localhost:5173
# Every mail is sent from FLOWCORTEX_MAIL_FROM_NAME <FLOWCORTEX_MAIL_FROM>. The link secret signs the
# unsubscribe links of care and promotional mail (no such mail exists yet): once one does, it must be
# at least 32 bytes and FLOWCORTEX_APP_PUBLIC_URL must be set, or the backend refuses to start.
# The rate limit is the calls each unsubscribe-link token and address may make per window.
FLOWCORTEX_MAIL_FROM=no-reply@flow-cortex.dev
FLOWCORTEX_MAIL_FROM_NAME=Nodi
FLOWCORTEX_MAIL_LINK_SECRET=
FLOWCORTEX_MAIL_LINK_RATE_LIMIT=10
FLOWCORTEX_MAIL_LINK_RATE_WINDOW=60s

# Vietnamese dubbing — optional, off by default; takes effect on `docker compose up -d backend`.
# It runs only with the switch on AND a Gemini API key; otherwise starting a dub run answers 503
# and a run in progress stops at its next translate or voice step.
FLOWCORTEX_DUB_ENABLED=false
# Uses the Gemini client and GEMINI_API_KEY (set in the Gemini section above) for the translation
# and voice models.

# Provider workers — each capability is selected independently. Defaults remain deterministic and
# offline. For a real demo, set SCRIPT_PROVIDER=openai and SPEECH_PROVIDER=edge.
# provider-worker runs script, storyboard and speech; provider-video-worker runs the video clips
# (the VIDEO_*, SEEDANCE_*, VEO_* and WAN_* settings below), as PROVIDER_VIDEO_WORKERS replicas
# that each run one clip at a time.
# Edge TTS is demo-only: it calls Microsoft's undocumented Edge Read Aloud endpoint (no SLA, it
# has broken before) and sends the approved script to Microsoft. Production speech needs a
# contracted provider behind SPEECH_PROVIDER.
# Seedance, Veo and Wan are third-party services: the chosen vendor receives each storyboard
# scene prompt and, when the clip step sends one, the run's first product image. Check the
# vendor's data terms before pointing a real run at it.
# Secrets only ever live in this file / your shell env / secret manager, never in code,
# DB, broker message or frontend bundle.
#
# To use OpenAI copy with Edge Vietnamese speech:
#   SCRIPT_PROVIDER=openai
#   SPEECH_PROVIDER=edge
#   SCRIPT_PROVIDER_API_KEY=sk-...
#   SCRIPT_PROVIDER_BASE_URL=https://your-provider.example.com/v1
#   SCRIPT_PROVIDER_MODEL=your-model-name
#
# Seedance through BytePlus ModelArk (base URL ends in /api/v3; an Alibaba Cloud Model Studio
# base URL ending in /api/v1 also works):
#   VIDEO_PROVIDER=seedance
#   SEEDANCE_API_KEY=your-modelark-key
#   SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
#   SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
#   SEEDANCE_RESOLUTION=480p
#
# Veo through the Gemini API:
#   VIDEO_PROVIDER=veo
#   VEO_API_KEY=your-gemini-key
#   VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#   VEO_MODEL=veo-3.1-fast-generate-preview
#
# Wan 2.2 5B Fast through Replicate:
#   VIDEO_PROVIDER=wan
#   WAN_API_KEY=your-replicate-token
#   WAN_BASE_URL=https://api.replicate.com/v1
#   WAN_MODEL=wan-video/wan-2.2-5b-fast
#   WAN_RESOLUTION=480p
#
# MiniMax H3 Lite through Replicate (supports 1-3 product reference images):
#   VIDEO_PROVIDER=minimax
#   MINIMAX_API_KEY=your-replicate-token
#   MINIMAX_BASE_URL=https://api.replicate.com/v1
#   MINIMAX_MODEL=minimax/h3-lite
#   MINIMAX_RESOLUTION=480P
#   MINIMAX_DURATION=5
PROVIDER_ADAPTER=fixture
SCRIPT_PROVIDER=fixture
SPEECH_PROVIDER=fixture
VIDEO_PROVIDER=fixture
# Capability-scoped credentials. Edge TTS does not require SPEECH_PROVIDER_API_KEY.
SCRIPT_PROVIDER_API_KEY=
SPEECH_PROVIDER_API_KEY=
VIDEO_PROVIDER_API_KEY=
SCRIPT_PROVIDER_BASE_URL=
SCRIPT_PROVIDER_MODEL=
SCRIPT_PROVIDER_FALLBACK_MODEL=
SPEECH_PROVIDER_BASE_URL=
SPEECH_PROVIDER_MODEL=
VIDEO_PROVIDER_BASE_URL=
VIDEO_PROVIDER_MODEL=
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
SEEDANCE_RESOLUTION=480p
VEO_API_KEY=
VEO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VEO_MODEL=veo-3.1-fast-generate-preview
WAN_API_KEY=
WAN_BASE_URL=https://api.replicate.com/v1
WAN_MODEL=wan-video/wan-2.2-5b-fast
WAN_RESOLUTION=480p
WAN_FRAMES_PER_SECOND=24
WAN_NUM_FRAMES=121
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.replicate.com/v1
MINIMAX_MODEL=minimax/h3-lite
MINIMAX_RESOLUTION=768P
MINIMAX_DURATION=5
VIDEO_PROVIDER_REQUEST_TIMEOUT_SECONDS=60
VIDEO_PROVIDER_POLL_INTERVAL_SECONDS=5
VIDEO_PROVIDER_POLL_TIMEOUT_SECONDS=480
# Seedance downloads the run's first product photo from a 10-minute presigned URL, so the
# object store must be reachable from the internet over HTTPS: set this to its public address
# (https://media.<domain>; compose.aws.yaml sets it from DOMAIN). The video worker refuses to
# start with Seedance while it is empty or not https://. Fixture, Veo and Wan ignore it.
S3_PUBLIC_ENDPOINT=
# How many clips run at once: one provider-video-worker container per clip.
PROVIDER_VIDEO_WORKERS=2
# How many renders run at once: one render-worker container per render_video job.
MEDIA_RENDER_WORKERS=1
# How many separations run at once: one audio-worker container per separate_audio job.
MEDIA_AUDIO_WORKERS=1
# The fetch worker downloads a member's link (fetch_video) through egress-fetch. Optional,
# the values shown are the defaults; both take effect on `docker compose up -d fetch-worker`.
# false refuses platform page links (YouTube and the like); a direct file link still works.
FETCH_PLATFORM_LINKS_ENABLED=true
# true only when egress-fetch forwards through an upstream that changes address per request:
# a platform's bot check or 403 is then retried. false (one cloud address) ends it at once.
FETCH_UPSTREAM_ROTATES=false
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+10%
FLOWCORTEX_PROVIDER_TIMEOUT_SECONDS=60

# Legacy fallback for existing deployments. Prefer the capability-scoped keys above.
# OPENAI_API_KEY=

# Name the worker reports in its logs and its result messages — optional.
WORKER_ID=flow-worker-1
PROVIDER_WORKER_ID=provider-worker-1

# Observability overlay (compose.observability.yaml) — required only with it.
# Grafana's `admin` password; there is no default, the overlay refuses to start without it.
GF_SECURITY_ADMIN_PASSWORD=change-me-grafana-admin
# Password of the read-only `flowcortex_monitor` role postgres-exporter signs in with
# (at least 8 characters).
POSTGRES_EXPORTER_PASSWORD=change-me-postgres-exporter

# Public deploy overlay (compose.aws.yaml) — required only with it. The apex
# domain: the overlay serves the app., admin. and media. subdomains of it and
# sets the store's public endpoint and allowed upload origin from it.
DOMAIN=example.com

# Outbound allowlist. The backend and the provider workers reach the internet only through
# egress-proxy, which allows the hosts in infra/egress-proxy/acl.yaml and refuses any host that
# resolves to a private, loopback, link-local or carrier-grade-NAT address. Unset, compose mounts
# that file. For an environment of its own (compose.aws.yaml requires it, and adds the SMTP relay
# host there), copy the file outside the checkout and point this at the copy:
#   cp infra/egress-proxy/acl.yaml /srv/flow-cortex/egress-acl.yaml
#   EGRESS_ACL_FILE=/srv/flow-cortex/egress-acl.yaml
# Add a host: append it under allowed_domains in that file, then recreate the proxy (no image
# rebuild, no backend or worker restart):
#   docker compose up -d --force-recreate egress-proxy
# Operator-supplied base URLs need an entry naming their exact host: a GEMINI_BASE_URL host
# outside *.googleapis.com, and a bare bytepluses.com in SEEDANCE_BASE_URL (a *.bytepluses.com
# entry does not match the bare domain). The payments region gate downloads the regional
# registries, so a host-side copy must also list ftp.apnic.net, ftp.arin.net, ftp.ripe.net,
# ftp.lacnic.net and ftp.afrinic.net. egress-fetch, the open tier for URL downloads, has no
# per-environment file.
# EGRESS_ACL_FILE=./infra/egress-proxy/acl.yaml
