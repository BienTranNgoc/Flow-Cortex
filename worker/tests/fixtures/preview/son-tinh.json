     ],
     "actions": [
      {
       "characterId": "chdzzaqdt3y0",
       "text": "Vua Hùng ngồi trên ngai vàng, nhìn Mị Nương với ánh mắt uy nghiêm và yêu thương, bắt đầu nói chuyện kén chồng.",
       "afterLine": 0,
       "propIds": [
        "prjtrde7iucy"
       ],
       "touch": null
      },
      {
       "characterId": "chlaga4oi65c",
       "text": "Mị Nương khẽ ngước nhìn cha rồi cúi đầu lắng nghe, ánh mắt bâng khuâng.",
       "afterLine": 1,
       "propIds": [],
       "touch": null,
       "motion": "nod",
       "targetId": "chdzzaqdt3y0"
      }
     ],
     "cutToNext": "gaze",
     "summary": "Vua Hùng ngồi trên ngai, gọi Mị Nương lại gần, dịu dàng bàn chuyện kén chồng. Mị Nương cúi đầu lắng nghe, ánh mắt bâng khuâng.",
     "origin": {
      "engine": "llm",
      "engineVersion": "claude-sonnet-4-6/2",
      "jobId": "7a1e4ad2-1d06-4369-884c-b0f68d5f96b8",
      "proposal": 0,
      "references": []
     }
    },
    "dialogue": [
     {
      "characterId": "chdzzaqdt3y0",
      "text": "Mị Nương, con đã đến tuổi cài trâm. Cha muốn kén cho con một người chồng xứng đáng.",
      "lang": "vi",
      "role": "tell",
      "acting": "Vua Hùng nhìn con gái bằng ánh mắt vừa uy nghiêm vừa yêu thương, giọng trầm ấm."
     },
     {
      "characterId": "chlaga4oi65c",
      "text": "Con xin vâng ý cha. Nhưng… người ấy là ai, con chưa dám nghĩ tới.",
      "lang": "vi",
      "role": "answer",
      "acting": "Mị Nương khẽ ngước nhìn cha rồi lại cúi xuống, giọng nhẹ như gió."
     },
     {
      "characterId": "chdzzaqdt3y0",
      "text": "Trời sẽ định, cha sẽ chọn. Người nào tài đức, người ấy được cưới con.",
      "lang": "vi",
      "role": "tell",
      "acting": "Vua Hùng gật đầu, giọng khẳng định nhưng ẩn chứa nỗi băn khoăn."
     }
    ],
