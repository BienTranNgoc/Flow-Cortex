       "motion": "walk_to",
       "targetId": "chdzzaqdt3y0"
      },
      {
       "characterId": "chdzzaqdt3y0",
       "text": "Vua Hùng đứng dậy, giọng vang lớn, tay chỉ ra ngoài cổng, tuyên bố điều kiện sính lễ.",
       "afterLine": 2,
       "propIds": [
        "pr51bebnuss1"
